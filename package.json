{
  "name": "mesto",
  "version": "1.0.0",
  "description": "MESTO E2E tooling; application dependencies live in frontend/.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:up": "docker compose -f docker-compose.e2e.yml --project-name mesto-e2e up --build --detach --wait --wait-timeout 180",
